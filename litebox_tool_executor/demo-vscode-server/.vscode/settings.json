{
    // ================================================================
    // LiteBox VS Code Server: Full agent sandboxing
    // ================================================================
    //
    // Prerequisites:
    //   1. Build the rootfs:
    //      wsl -d Ubuntu -- bash scripts/prepare-vscode-rootfs-staged.sh
    //   2. Build the binaries in WSL2:
    //      wsl -d Ubuntu -- bash -c 'cd /mnt/c/src/litebox-vscode-server && cargo build -p litebox_tool_executor -p litebox_broker -p litebox_runner_linux_userland'
    //
    // Setup (one-time, in your Default profile user settings — Ctrl+Shift+P
    // → "Preferences: Open User Settings (JSON)"):
    //
    //   "remote.SSH.path": "C:\\src\\litebox-vscode-server\\litebox_tool_executor\\scripts\\litebox-ssh-shim.ps1",
    //   "remote.SSH.showLoginTerminal": true,
    //
    // These settings have application scope and CANNOT be set per-workspace.
    //
    // Also add to ~/.ssh/config:
    //   Host litebox
    //     HostName litebox
    //
    // Usage:
    //   1. Ctrl+Shift+P -> "Remote-SSH: Connect to Host..." -> litebox
    //   2. VS Code connects to the LiteBox sandbox via stdio transport
    //   3. All agent operations execute inside the sandbox
    //   4. Logs: /tmp/litebox-vscode-server-logs/*.{jsonl,broker.log,server.log}

    // Terminal profiles (for shell-only sandboxing as fallback)
    "terminal.integrated.profiles.windows": {
        "LiteBox Sandbox (WSL2)": {
            "path": "wsl.exe",
            "args": ["-d", "Ubuntu", "--",
                "/mnt/c/src/litebox-vscode-server/target/debug/litebox_tool_executor",
                "--rootfs", "/home/wportnoy/vscode-rootfs",
                "--interactive"
            ],
            "icon": "shield"
        },
        "PowerShell": {
            "path": "powershell.exe",
            "icon": "terminal-powershell"
        }
    }
}
