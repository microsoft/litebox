{
    // ================================================================
    // LiteBox VS Code Server: Full agent sandboxing
    // ================================================================
    //
    // Prerequisites:
    //   1. Build the Docker images:
    //      Run task "LiteBox: Build Docker Images"
    //   2. Build the binaries in WSL2:
    //      Run task "LiteBox: Build All"
    //
    // Setup:
    //   remote.SSH.path and remote.SSH.showLoginTerminal have application
    //   scope. To avoid affecting your normal SSH workflows, create a
    //   dedicated VS Code profile:
    //
    //   1. File → Preferences → Profiles → Create Profile → name it "LiteBox"
    //   2. In the LiteBox profile's user settings (JSON), add:
    //        "remote.SSH.showLoginTerminal": true,
    //        "remote.SSH.remotePlatform": { "litebox": "linux" }
    //   All remote.SSH.* settings have application scope — they cannot
    //   be set per-workspace, only in user settings (Default profile).
    //
    // Usage:
    //   1. Switch to the "LiteBox" profile
    //   2. Run task "LiteBox: Start VS Code Server"
    //   3. Ctrl+Shift+P → "Remote-SSH: Connect to Host..." → litebox
    //   4. All operations execute inside the sandbox
    //
    // Note: The Docker container IS the rootfs. Binaries are bind-mounted
    // at /opt/litebox/ from target/debug/. No manual rootfs export needed.

    // Terminal profiles (for shell-only sandboxing via Docker)
    "terminal.integrated.profiles.windows": {
        "LiteBox Sandbox (Docker)": {
            "path": "docker",
            "args": ["run", "--rm", "-it", "--cap-add", "SYS_PTRACE",
                "-v", "C:\\src\\litebox-vscode-server\\target\\debug:/opt/litebox:ro",
                "-v", "C:\\src\\litebox-vscode-server\\litebox_tool_executor\\policies:/opt/policies:ro",
                "litebox-test",
                "/opt/litebox/litebox_tool_executor",
                "--rootfs", "/",
                "--policy", "/opt/policies/demo-policy.json",
                "--interactive"
            ],
            "icon": "shield"
        },
        "PowerShell": {
            "path": "powershell.exe",
            "icon": "terminal-powershell"
        }
    }
}
