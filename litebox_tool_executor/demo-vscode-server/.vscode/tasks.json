{
    // ────────────────────────────────────────────────────────────
    // LiteBox VS Code Remote Server demo tasks.
    //
    // Assumes this workspace is opened from a WSL bash shell
    // (`code .` from `<worktree>/litebox_tool_executor/demo-vscode-server`);
    // VS Code's Remote-WSL extension then runs all tasks inside
    // the same WSL distribution where the source tree lives.
    //
    // All paths are anchored at `${workspaceFolder}/../..`, which
    // resolves to the **repo root of whichever worktree** this
    // workspace is opened from. So the demo works equally well
    // from `~/src/litebox/litebox_tool_executor/demo-vscode-server`
    // (main worktree) and from any sibling worktree like
    // `~/src/litebox-<work-stream>/litebox_tool_executor/demo-vscode-server`.
    //
    // Cargo's default `target/` directory is used — no
    // `--target-dir` overrides. Docker can `-v` bind-mount
    // `<worktree>/target/debug` directly (WSL ext4 is fine for
    // ELF mmap; the old NTFS-via-`\\wsl$` workaround is no
    // longer needed).
    //
    // Single-demo-at-a-time invariant: the container is named
    // `litebox-vscode` (shared across worktrees) and binds host
    // port `2222`. Starting a demo from worktree B while a demo
    // from worktree A is running will: (a) `docker rm -f
    // litebox-vscode` kills A's container, and (b) B's
    // `docker run` then binds port 2222 cleanly. So "switch
    // worktrees, restart demo" works; "two demos side-by-side"
    // does not (would need per-worktree container names and
    // ports — out of scope for the hand-driven Remote-SSH
    // workflow where you only attach one VS Code window at a
    // time anyway).
    //
    "version": "2.0.0",
    "tasks": [
        {
            // One-shot: run all three setup steps in sequence,
            // then start the server. Use this for first-time
            // setup or after switching worktrees. The
            // `dependsOrder: "sequence"` is required — without
            // it VS Code starts the dependent tasks in parallel
            // and the docker-run task races the docker-build.
            "label": "LiteBox: Setup and Start VS Code Server",
            "dependsOrder": "sequence",
            "dependsOn": [
                "LiteBox: Build",
                "LiteBox: Build VS Code Image",
                "LiteBox: Start VS Code Server"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Build",
            "type": "shell",
            "command": "cd ${workspaceFolder}/../.. && cargo build -p litebox_tool_executor -p litebox_broker -p litebox_runner_linux_userland -p litebox_audit_query",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Build VS Code Image",
            "type": "shell",
            "command": "cd ${workspaceFolder}/../.. && docker build --target litebox-vscode -t litebox-vscode -f litebox_tool_executor/rootfs/Dockerfile .",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Start VS Code Server",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/../../target/litebox-audit; docker rm -f litebox-vscode 2>/dev/null; docker run --rm --name litebox-vscode -p 2222:2222 --cap-add SYS_PTRACE -v ${workspaceFolder}/../../target/debug:/opt/litebox:ro -v ${workspaceFolder}/../../litebox_tool_executor/policies:/opt/policies:ro -v ${workspaceFolder}/../../target/litebox-audit:/opt/audit litebox-vscode /opt/litebox/litebox_tool_executor --rootfs / --vscode-server --ssh-port 2222 --policy /opt/policies/demo-policy.json --audit-log /opt/audit",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Start VS Code Server (Debug)",
            "type": "shell",
            "command": "mkdir -p ${workspaceFolder}/../../target/litebox-audit; docker rm -f litebox-vscode 2>/dev/null; docker run --rm --name litebox-vscode -p 2222:2222 -p 9999:9999 --cap-add SYS_PTRACE -v ${workspaceFolder}/../../target/debug:/opt/litebox:ro -v ${workspaceFolder}/../../litebox_tool_executor/policies:/opt/policies:ro -v ${workspaceFolder}/../../target/litebox-audit:/opt/audit litebox-vscode /opt/litebox/litebox_tool_executor --rootfs / --vscode-server --ssh-port 2222 --policy /opt/policies/demo-policy.json --audit-log /opt/audit --debug 9999",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Stop VS Code Server",
            "type": "shell",
            "command": "docker stop litebox-vscode || true",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            // Live "frontier" tree of the sandbox: allowed (green) vs denied
            // (red) filesystem paths and network endpoints, updating as the
            // agent runs. Reads the bind-mounted audit dir the server task
            // writes to. Use `watch --policy-only <dir>` for a scrolling log
            // instead of the tree.
            "label": "LiteBox: Watch Sandbox Frontier",
            "type": "shell",
            "command": "cd ${workspaceFolder}/../.. && cargo build -q -p litebox_audit_query && ./target/debug/litebox_audit_query watch --tree target/litebox-audit",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "echo": true
            }
        },
        {
            // Scrolling live trace of sandbox activity: broker policy
            // decisions (tcp/udp/fs/dns) and, if the runner was built with
            // `--features audit_log`, per-syscall events too. This is the
            // cross-platform successor to the old View-AuditLog.ps1 viewer.
            "label": "LiteBox: Watch Sandbox Trace",
            "type": "shell",
            "command": "cd ${workspaceFolder}/../.. && cargo build -q -p litebox_audit_query && ./target/debug/litebox_audit_query watch target/litebox-audit",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": true
            }
        },
        {
            // Open both visualizers side by side (parallel dependsOn opens two
            // dedicated terminal panels): the frontier tree + the scrolling
            // trace. Run this after the server task is up.
            "label": "LiteBox: Watch Sandbox (Tree + Trace)",
            "dependsOn": [
                "LiteBox: Watch Sandbox Frontier",
                "LiteBox: Watch Sandbox Trace"
            ],
            "problemMatcher": []
        },
        {
            "label": "LiteBox: Run Integration Tests (vscode::*)",
            "type": "shell",
            "command": "cd ${workspaceFolder}/../.. && cargo test -p litebox_test_harness --test integration -- 'vscode::'",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        }
    ]
}
