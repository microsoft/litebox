{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LiteBox: Start VS Code Server",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "-d", "Ubuntu", "--",
                "/mnt/c/src/litebox-vscode-server/target/debug/litebox_tool_executor",
                "--rootfs", "/home/wportnoy/vscode-rootfs",
                "--vscode-server",
                "--record-baseline"
            ],
            "problemMatcher": [],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Tail Audit Log",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "-d", "Ubuntu", "--",
                "bash", "-c",
                "sleep 3 && tail -f $(ls -t /tmp/litebox-vscode-server-logs/*.jsonl 2>/dev/null | head -1) 2>/dev/null || echo 'No audit log found yet — waiting...' && sleep 30"
            ],
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "focus": false
            }
        }
    ]
}
