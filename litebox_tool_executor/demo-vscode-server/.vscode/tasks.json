{
    // ────────────────────────────────────────────────────────────
    // LiteBox VS Code Remote Server demo tasks.
    //
    // Assumes this workspace is opened from a WSL bash shell
    // (`code .` from `~/src/litebox/litebox_tool_executor/demo-vscode-server`);
    // VS Code's Remote-WSL extension then runs all tasks inside
    // the same WSL distribution where the source tree lives.
    //
    // The litebox repo lives on the WSL ext4 filesystem at
    // `~/src/litebox`. Cargo's default `target/` directory is
    // used — no `--target-dir` overrides. Docker can `-v`
    // bind-mount `~/src/litebox/target/debug` directly (WSL ext4
    // is fine for ELF mmap; the old NTFS-via-`\\wsl$` workaround
    // is no longer needed).
    // ────────────────────────────────────────────────────────────
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LiteBox: Build",
            "type": "shell",
            "command": "cd ~/src/litebox && cargo build -p litebox_tool_executor -p litebox_broker -p litebox_runner_linux_userland && cargo rustc --target-dir target/nonpie -p litebox_test_harness -- -C link-args=-no-pie",
            "group": "build",
            "problemMatcher": "$rustc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Build VS Code Image",
            "type": "shell",
            "command": "cd ~/src/litebox && docker build --target litebox-vscode -t litebox-vscode -f litebox_tool_executor/rootfs/Dockerfile .",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Start VS Code Server",
            "type": "shell",
            "command": "docker rm -f litebox-vscode 2>/dev/null; docker run --rm --name litebox-vscode -p 2222:2222 --cap-add SYS_PTRACE -v $HOME/src/litebox/target/debug:/opt/litebox:ro litebox-vscode /opt/litebox/litebox_tool_executor --rootfs / --vscode-server --ssh-port 2222 --record-baseline",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Start VS Code Server (Debug)",
            "type": "shell",
            "command": "docker rm -f litebox-vscode 2>/dev/null; docker run --rm --name litebox-vscode -p 2222:2222 -p 9999:9999 --cap-add SYS_PTRACE -v $HOME/src/litebox/target/debug:/opt/litebox:ro litebox-vscode /opt/litebox/litebox_tool_executor --rootfs / --vscode-server --ssh-port 2222 --record-baseline --debug 9999",
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "echo": true
            }
        },
        {
            "label": "LiteBox: Stop VS Code Server",
            "type": "shell",
            "command": "docker stop litebox-vscode || true",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "LiteBox: Run Integration Tests (vscode::*)",
            "type": "shell",
            "command": "cd ~/src/litebox && cargo test -p litebox_test_harness --test integration -- 'vscode::'",
            "group": "test",
            "problemMatcher": "$rustc",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "echo": true
            }
        }
    ]
}
