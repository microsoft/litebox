{
    // LiteBox Sandbox — VS Code Terminal Profile
    //
    // Copy the relevant sections into your VS Code settings.json
    // (Ctrl+Shift+P → "Preferences: Open User Settings (JSON)")
    //
    // Prerequisites:
    //   1. Build the executor:  cargo build -p litebox_tool_executor
    //   2. Prepare rootfs:      (in WSL2) bash litebox_tool_executor/scripts/prepare-rootfs.sh
    //   3. Update the paths below to match your setup.

    "terminal.integrated.profiles.windows": {
        "LiteBox Sandbox": {
            "path": "${workspaceFolder}\\litebox_tool_executor\\scripts\\litebox-shell.cmd",
            "env": {
                "LITEBOX_ROOTFS": "${workspaceFolder}\\target\\busybox-minimal.tar"
                // Optional: restrict guest operations with a policy file
                // "LITEBOX_POLICY": "${workspaceFolder}\\litebox_tool_executor\\policies\\deny-network.json"
                // Optional: write audit trail to a file
                // "LITEBOX_AUDIT": "${workspaceFolder}\\target\\litebox-audit.jsonl"
            },
            "icon": "shield"
        }
    },

    // Uncomment to make the sandbox the default terminal for agent mode:
    // "terminal.integrated.defaultProfile.windows": "LiteBox Sandbox",

    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "LiteBox: View Audit Log",
                "type": "shell",
                "command": "Get-Content -Wait -Tail 50 target\\litebox-audit.jsonl | ForEach-Object { $_ | ConvertFrom-Json | Format-List }",
                "problemMatcher": [],
                "presentation": {
                    "reveal": "always",
                    "panel": "dedicated"
                }
            }
        ]
    }
}
