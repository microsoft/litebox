{
    "filesystem": {
        "allow_read": ["/", "/bin", "/bin/**", "/usr", "/usr/**", "/lib", "/lib/**", "/lib64", "/lib64/**", "/tmp", "/tmp/**", "/workspace", "/workspace/**", "/etc", "/etc/**", "/dev/**"],
        "allow_write": ["/tmp/**", "/workspace/**"],
        "deny": ["**/passwd", "**/shadow", "**/.ssh/**"]
    },
    "network": {
        "deny_all": true,
        "allow_connect": [
            "api.github.com:443",
            "github.com:443",
            "*.githubusercontent.com:443",
            "pypi.org:443",
            "*.pypi.org:443",
            "registry.npmjs.org:443",
            "*.npmjs.org:443"
        ]
    }
}
