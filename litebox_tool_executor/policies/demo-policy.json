{
    "filesystem": {
        "allow_read": [],
        "allow_write": [
            "/tmp/**",
            "/shared/**",
            "/root/.cache",
            "/root/.cache/**",
            "/root/.copilot",
            "/root/.copilot/**",
            "/root/.vscode-server",
            "**/workspace/**",
            "**/workspaces/**",
            "**/.vscode-server/**",
            "/proc/self/fd/**",
            "/run/dropbear.pid",
            "/var/run/dropbear.pid"
        ],
        "deny": [
            "**/.ssh/id_*",
            "**/.ssh/*_rsa*",
            "**/.ssh/*_dsa*",
            "**/.ssh/*_ecdsa*",
            "**/.ssh/*_ed25519*",
            "**/.ssh/config",
            "**/shadow",
            "**/id_rsa*",
            "**/id_ed25519*",
            "**/.git/config"
        ]
    },
    "network": {
        "deny_all": true,
        "allow_connect": [
            "update.code.visualstudio.com:443",
            "vscode.download.prss.microsoft.com:443",
            "*.prss.microsoft.com:443",
            "main.vscode-cdn.net:443",
            "*.vscode-cdn.net:443",
            "*.vo.msecnd.net:443",
            "*.visualstudio.com:443",
            "*.githubcopilot.com:443",
            "copilot-proxy.githubusercontent.com:443",
            "copilot-telemetry.githubusercontent.com:443",
            "origin-tracker.githubusercontent.com:443",
            "github.com:443",
            "api.github.com:443",
            "vscode-auth.github.com:443",
            "collector.github.com:443",
            "default.exp-tas.com:443",
            "marketplace.visualstudio.com:443",
            "*.gallerycdn.azureedge.net:443",
            "vscode.blob.core.windows.net:443",
            "mobile.events.data.microsoft.com:443",
            "*.githubusercontent.com:443",
            "pypi.org:443",
            "*.pypi.org:443",
            "registry.npmjs.org:443",
            "*.npmjs.org:443"
        ]
    }
}
