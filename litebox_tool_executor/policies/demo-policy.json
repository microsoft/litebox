{
    "filesystem": {
        "allow_read": ["/", ".", "/bin", "/bin/**", "/usr", "/usr/**", "/tmp", "/tmp/**", "/workspace", "/workspace/**", "/dev/**"],
        "allow_write": ["/tmp/**", "/workspace/**"],
        "deny": ["/lib/**", "**/passwd", "**/shadow", "**/.ssh/**"]
    },
    "network": {
        "deny_all": true,
        "allow_connect": []
    },
    "process": {
        "allow_exec": ["/bin/*", "/usr/bin/*"]
    }
}
