{
    "filesystem": {
        "allow_read": ["/", "/bin", "/bin/**", "/usr", "/usr/**", "/lib", "/lib/**", "/lib64", "/lib64/**", "/tmp", "/tmp/**", "/workspace", "/workspace/**", "/etc", "/etc/**", "/dev/**"],
        "allow_write": ["/tmp/**", "/workspace/**"],
        "deny": ["**/passwd", "**/shadow", "**/.ssh/**"]
    },
    "network": {
        "deny_all": true,
        "allow_connect": []
    },
    "process": {
        "allow_exec": ["/bin/*", "/usr/bin/*"]
    }
}
